<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0a0e17" />
    </radialGradient>
    <linearGradient id="fireGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ea580c" />
      <stop offset="50%" stop-color="#f97316" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Fondo Dark Carbon Squircle -->
  <rect width="512" height="512" rx="128" fill="url(#bgGrad)" />
  <rect width="504" height="504" x="4" y="4" rx="124" fill="none" stroke="#f97316" stroke-width="6" stroke-opacity="0.3" />

  <!-- Cancha / Balón Biomecánico Estilizado -->
  <circle cx="256" cy="270" r="160" fill="none" stroke="#334155" stroke-width="8" stroke-dasharray="12 12" />
  <path d="M96 270 Q 256 160 416 270" fill="none" stroke="#475569" stroke-width="6" stroke-opacity="0.4" />
  <path d="M96 270 Q 256 380 416 270" fill="none" stroke="#475569" stroke-width="6" stroke-opacity="0.4" />
  <line x1="256" y1="110" x2="256" y2="430" stroke="#475569" stroke-width="6" stroke-opacity="0.4" />

  <!-- Cabeza de Lobo Atlético / Fuego (Icono Wild Wolves) -->
  <g filter="url(#glow)">
    <!-- Orejas de Lobo -->
    <path d="M160 130 L220 220 L170 230 Z" fill="url(#fireGrad)" />
    <path d="M352 130 L342 230 L292 220 Z" fill="url(#fireGrad)" />
    
    <!-- Silueta Principal / Quijada y Corona -->
    <path d="M256 160 L320 240 L300 320 L256 360 L212 320 L192 240 Z" fill="url(#fireGrad)" />
    
    <!-- Ojos penetrantes de Lobo (Ámbar brillante) -->
    <polygon points="215,250 235,260 220,265" fill="#ffffff" />
    <polygon points="297,250 292,265 277,260" fill="#ffffff" />

    <!-- Hocico y Nariz -->
    <polygon points="256,310 248,328 264,328" fill="#0a0e17" />
  </g>

  <!-- Anillo de Acento Superior -->
  <circle cx="256" cy="80" r="14" fill="#f97316" filter="url(#glow)" />
</svg>
